<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <!-- Hard hat outer shape -->
  <path d="M100 220 
           C100 120, 160 70, 250 70 
           C340 70, 400 120, 400 220 
           L370 220 
           C370 150, 320 110, 250 110 
           C180 110, 130 150, 130 220 
           Z" 
        fill="#1B2A4A"/>

  <!-- Hat brim -->
  <path d="M70 220 
           Q250 255 430 220 
           L430 245 
           Q250 280 70 245 
           Z" 
        fill="#1B2A4A"/>

  <!-- Orange dome -->
  <path d="M155 215 
           C155 145, 195 115, 250 115 
           C305 115, 345 145, 345 215 
           Z" 
        fill="#F5A623"/>

  <!-- White highlight curve -->
  <path d="M175 210 
           C185 155, 220 130, 265 125 
           C250 120, 200 140, 175 180 
           Z" 
        fill="#FFFFFF"/>

  <!-- Building body -->
  <path d="M120 240 
           L120 380 
           L380 380 
           L380 240 
           L320 240 
           L320 340 
           L180 340 
           L180 240 
           Z" 
        fill="#1B2A4A"/>

  <!-- Gray vertical panels -->
  <rect x="195" y="255" width="35" height="110" fill="#7A8B9A"/>
  <rect x="245" y="255" width="35" height="110" fill="#7A8B9A"/>
  <rect x="295" y="255" width="35" height="110" fill="#7A8B9A"/>

  <!-- Left structural arrow -->
  <path d="M120 280 
           L85 280 
           L85 330 
           L120 330 
           L100 305 
           Z" 
        fill="#1B2A4A"/>

  <!-- Bottom base line -->
  <rect x="95" y="380" width="310" height="20" fill="#1B2A4A"/>
</svg>
